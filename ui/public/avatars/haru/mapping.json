    "tilt": { "axis": "roll", "degrees": 10, "ms": 1100, "waves": 1 },
    "startle": { "axis": "pitch", "degrees": 8, "ms": 350, "waves": 1 }
  },
  "frame": { "zoom": 1.55, "offsetY": 0.3 }
}
