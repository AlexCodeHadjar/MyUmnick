# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# Инструменты
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.import_linter_cache/

# Веса моделей и рантайм-данные (раздел 9.6)
models/
logs/
data/
# Данные тестов — часть репозитория: без них падает сборка тестов на чистой копии (git archive).
!tests/data/

# Образцы голосов (37 МБ): для прослушивания, не для истории
bench/results/tts_samples/

# Локальный конфиг пользователя (раздел 5.12)
config/user.toml

# UI (Этап 5)
node_modules/
ui/dist/
ui/src-tauri/target/
# Схемы прав, которые tauri-build пересоздаёт при каждой сборке
ui/src-tauri/gen/
# Live2D (ADR-0011): проприетарный Cubism Core и модели — пользователь кладёт сам, в git не идут.
# mapping.json — наш файл, его храним.
ui/public/live2d/
ui/public/avatars/**
!ui/public/avatars/*/
!ui/public/avatars/*/mapping.json

# Локальные настройки ИИ-инструментов
.claude/settings.local.json
.claude/launch.json

# ОС и редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/

# Локальные переопределения Vite (ui/.env.local)
ui/.env*.local

packaging/build/
packaging/dist/
